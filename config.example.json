{
  "providers": [
    "linkedin",
    "jsearch"
  ],
  "filters": {
    "countries": [
      "US",
      "CA",
      "GB",
      "DE",
      "NL",
      "IE",
      "AU"
    ],
    "searchQueries": [
      "remote developer",
      "remote engineer",
      "remote golang"
    ],
    "keywords": [
      "developer",
      "engineer",
      "backend",
      "golang",
      "entwickler"
    ],
    "excludeKeywords": [
      "sales",
      "manager"
    ],
    "employmentTypes": [
      "FULLTIME",
      "CONTRACTOR"
    ],
    "seniority": [
      "mid",
      "senior"
    ],
    "remoteOnly": false,
    "relocationOnly": false,
    "requireRemoteOrRelocation": true,
    "postedWithinHours": 96,
    "companyWhitelist": [],
    "companyBlacklist": []
  },
  "numPages": 2,
  "maxPerRun": 20,
  "delaySeconds": 4,
  "allowInternship": false,
  "minDescriptionRunes": 200,
  "rotation": {
    "slotHours": 4,
    "countriesPerRun": 1
  },
  "summary": "onChange"
}
