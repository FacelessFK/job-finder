{
  "providers": ["jsearch"],
  "filters": {
    "countries": [
      "US", "CA",
      "GB", "IE", "DE", "NL", "FR", "ES", "IT", "PT",
      "SE", "DK", "NO", "FI", "CH", "AT", "BE", "PL", "CZ",
      "AU"
    ],
    "keywords": ["developer", "engineer", "designer", "product manager"],
    "excludeKeywords": ["sales"],
    "employmentTypes": ["FULLTIME", "CONTRACTOR"],
    "seniority": ["mid", "senior", "lead"],
    "remoteOnly": false,
    "relocationOnly": false,
    "requireRemoteOrRelocation": true,
    "postedWithinHours": 96,
    "companyWhitelist": [],
    "companyBlacklist": []
  },
  "rotation": {
    "slotHours": 4,
    "countriesPerRun": 1
  },
  "summary": "onChange",
  "numPages": 1,
  "maxPerRun": 25,
  "delaySeconds": 4,
  "allowInternship": false,
  "minDescriptionRunes": 200
}
